#!/bin/sh
set -e

case "$1" in
    remove)
        if command -v systemctl >/dev/null 2>&1 && [ -d /run/systemd/system ]; then
            systemctl daemon-reload || true
        fi
        ;;
    purge)
        rm -f \
            /etc/fusionpanel/fusionpanel.env \
            /etc/fusionpanel/fusionpanel-agent.env \
            /etc/fusionpanel/initial-credentials.txt
        rmdir /etc/fusionpanel 2>/dev/null || true
        rm -rf /var/lib/fusionpanel /var/log/fusionpanel
        if command -v systemctl >/dev/null 2>&1 && [ -d /run/systemd/system ]; then
            systemctl daemon-reload || true
        fi
        ;;
    upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
        ;;
    *)
        echo "postrm called with unknown argument '$1'" >&2
        exit 1
        ;;
esac

exit 0
