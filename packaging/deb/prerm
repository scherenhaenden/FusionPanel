#!/bin/sh
set -e

case "$1" in
    remove|deconfigure)
        if command -v systemctl >/dev/null 2>&1 && [ -d /run/systemd/system ]; then
            systemctl stop fusionpanel-agent.service fusionpanel.service fusionpanel-nginx-helper.service || true
            systemctl disable fusionpanel-agent.service fusionpanel.service fusionpanel-nginx-helper.service >/dev/null 2>&1 || true
        fi
        ;;
    upgrade|failed-upgrade)
        ;;
    *)
        echo "prerm called with unknown argument '$1'" >&2
        exit 1
        ;;
esac

exit 0
