ARG UBUNTU_BASE=ubuntu:24.04@sha256:77eb101c607d6e3d4f5ad0c8a02c2136c689b98aba1f359e6502ba517e5c57ec
FROM ${UBUNTU_BASE}

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install --no-install-recommends -y \
      ca-certificates \
      docker.io \
      libgcc-s1 \
    && rm -rf /var/lib/apt/lists/*

COPY start-agent.sh /usr/local/bin/start-sprint13-agent.sh
RUN chmod 0555 /usr/local/bin/start-sprint13-agent.sh

ENTRYPOINT ["/usr/local/bin/start-sprint13-agent.sh"]
